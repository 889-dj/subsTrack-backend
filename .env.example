# --- Server ---
# Port the API listens on. Coolify/Caddy will proxy 443 -> this.
PORT=8080
# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Pretty local logs. Docker Compose disables this because the slim runtime
# image intentionally omits the development-only formatter.
LOG_PRETTY=true

# --- Clerk ---
# Required for authenticated routes. Get from https://dashboard.clerk.com -> API Keys.
CLERK_SECRET_KEY=sk_test_xxx
# Optional: forces networkless JWT verification (no per-request Clerk round-trip).
CLERK_JWT_KEY=
# Optional JWT claim restrictions. Values are comma-separated where noted.
CLERK_AUTHORIZED_PARTIES=
CLERK_AUDIENCE=

# --- Database ---
# Neon connection string or local Postgres (see docker-compose.yml).
# postgresql://user:password@host:5432/dbname
DATABASE_URL=postgres://postgres:postgres@localhost:5432/substrack

# --- Webhooks ---
# Clerk webhook signing secret (dashboard -> Webhooks -> your endpoint -> Signing secret).
CLERK_WEBHOOK_SECRET=whsec_xxx
# RevenueCat webhook auth secret (dashboard -> Integrations -> Webhooks).
REVENUECAT_WEBHOOK_SECRET=
# Secret RevenueCat REST API key. Required server-side for account deletion.
REVENUECAT_SECRET_API_KEY=

# --- Subscription logos ---
# Optional logo.dev publishable token (free tier, 500k req/month:
# https://logo.dev). Leave empty to fall back to Google's key-free favicon
# service — lower resolution, but no signup required.
LOGO_DEV_TOKEN=

# --- AI spend insights ---
# Optional OpenRouter key for GET /v1/insights (free tier, no card:
# https://openrouter.ai/keys). Leave empty and the route returns an empty
# result instead of erroring.
OPENROUTER_API_KEY=
# Any OpenRouter model id works; defaults to a free one if unset.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Profile photo uploads ---
# Optional Cloudinary URL for POST /v1/me/avatar (free tier, no card:
# https://cloudinary.com — Dashboard shows this as one ready-to-copy value).
# Leave empty and the endpoint responds 503 instead of accepting an upload.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# --- CORS ---
# Comma-separated origins allowed to call the API from a browser (Expo web).
# Leave empty in development to allow all; set to your domain in production.
# e.g. https://app.substrack.app,https://admin.substrack.app
CORS_ORIGINS=

# --- Abuse protection / background work ---
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
DELETION_RETRY_INTERVAL_MS=60000
# How often to scan for renewals due within 24h and send a push reminder.
# No API key needed — Expo's push service is free and keyless.
RENEWAL_REMINDER_INTERVAL_MS=1800000
