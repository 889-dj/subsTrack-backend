# --- Server ---
# Port the API listens on. Coolify/Caddy will proxy 443 -> this.
PORT=8080
# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Clerk ---
# Required for authenticated routes. Get from https://dashboard.clerk.com -> API Keys.
CLERK_SECRET_KEY=sk_test_xxx
# Optional: forces networkless JWT verification (no per-request Clerk round-trip).
CLERK_JWT_KEY=
# Optional JWT claim restrictions. Values are comma-separated where noted.
CLERK_AUTHORIZED_PARTIES=
CLERK_AUDIENCE=

# --- Database ---
# Neon connection string or local Postgres (see docker-compose.yml).
# postgresql://user:password@host:5432/dbname
DATABASE_URL=postgres://postgres:postgres@localhost:5432/substrack

# --- Webhooks ---
# Clerk webhook signing secret (dashboard -> Webhooks -> your endpoint -> Signing secret).
CLERK_WEBHOOK_SECRET=whsec_xxx
# RevenueCat webhook auth secret (dashboard -> Integrations -> Webhooks).
REVENUECAT_WEBHOOK_SECRET=
# Secret RevenueCat REST API key. Required server-side for account deletion.
REVENUECAT_SECRET_API_KEY=

# --- CORS ---
# Comma-separated origins allowed to call the API from a browser (Expo web).
# Leave empty in development to allow all; set to your domain in production.
# e.g. https://app.substrack.app,https://admin.substrack.app
CORS_ORIGINS=

# --- Abuse protection / background work ---
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
DELETION_RETRY_INTERVAL_MS=60000
